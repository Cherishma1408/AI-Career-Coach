# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSED TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# AI CONFIGURATION (SERVER-SIDE ONLY)
# ==========================================
# Google Gemini API Key (recommended)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: OpenAI or OpenAI-compatible API (e.g. OpenRouter, Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=

# ==========================================
# JOB SEARCH API CONFIGURATION (OPTIONAL)
# ==========================================
# Supported providers: Adzuna, JSearch (RapidAPI), or free Arbeitnow/Remotive
# For Adzuna:
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# For RapidAPI JSearch:
RAPIDAPI_KEY=
